<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    # B1: DocumentRoot is the project root. Block internals from HTTP.
    RewriteRule ^(config|App|Core|storage|logs|cli|database|tests|vendor)(/|$) - [F,L]
    # Developer guide: no app login — forbid non-local access (localhost / ::1 still OK).
    RewriteCond %{REMOTE_ADDR} !^127\.0\.0\.1$
    RewriteCond %{REMOTE_ADDR} !^::1$
    RewriteRule ^dev-help(/|$) - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
