<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    # B1: When document root is the project root (not recommended), block internals.
    RewriteRule ^(config|App|Core|storage|logs|cli|database|tests|vendor)(/|$) - [F,L]
    # Developer guide: no app login — forbid non-local access (localhost / ::1 still OK).
    # Prefer DocumentRoot = public/ in production so /dev-help is not under the web root.
    RewriteCond %{REMOTE_ADDR} !^127\.0\.0\.1$
    RewriteCond %{REMOTE_ADDR} !^::1$
    RewriteRule ^dev-help(/|$) - [F,L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
