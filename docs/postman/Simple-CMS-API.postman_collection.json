{
  "info": {
    "name": "Simple CMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "REST API and public JSON endpoints for Simple CMS. Set baseUrl (e.g. http://cms.local). Login stores token for Bearer auth."
  },
  "variable": [
    {"key": "baseUrl", "value": "http://cms.local"},
    {"key": "token", "value": ""}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"},
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "CMS (authenticated)",
      "item": [
        {
          "name": "List Pages",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/pages"
          }
        },
        {
          "name": "Get Page",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/pages/1"
          }
        },
        {
          "name": "Create Page",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"API Page\",\n  \"status\": \"draft\",\n  \"body\": \"<p>Hello</p>\"\n}"},
            "url": "{{baseUrl}}/api/pages"
          },
          "description": "Requires add_pages. Optional layout or layout_json, content_password, remove_content_password. GET responses never include password_hash (password_protected flag instead)."
        },
        {
          "name": "Update Page",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"API Page Updated\",\n  \"status\": \"draft\"\n}"},
            "url": "{{baseUrl}}/api/pages/1"
          },
          "description": "Requires edit_pages. Partial merge with existing row. Optional content_password / remove_content_password. password_hash is never returned."
        },
        {
          "name": "Delete Page",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/pages/1"
          },
          "description": "Soft-delete. Requires delete_pages."
        },
        {
          "name": "List Posts",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/posts"
          },
          "description": "Posts include featured_image_id and blocks_json when set."
        },
        {
          "name": "Get Post",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/posts/1"
          }
        },
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"API Post\",\n  \"status\": \"draft\",\n  \"excerpt\": \"Short\",\n  \"body\": \"<p>Hello</p>\",\n  \"tags\": \"news,api\",\n  \"is_sticky\": false,\n  \"published_at\": \"\"\n}"},
            "url": "{{baseUrl}}/api/posts"
          },
          "description": "Requires add_posts. Optional layout or layout_json, is_sticky, published_at (future times stay off the public site), content_password, remove_content_password. GET never returns password_hash."
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {"mode": "raw", "raw": "{\n  \"title\": \"API Post Updated\",\n  \"status\": \"draft\",\n  \"is_sticky\": true\n}"},
            "url": "{{baseUrl}}/api/posts/1"
          },
          "description": "Requires edit_posts. Omitting tags keeps existing tags. Optional is_sticky, published_at, content_password, remove_content_password."
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/posts/1"
          },
          "description": "Soft-delete. Requires delete_posts."
        },
        {
          "name": "List Media",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/media"
          }
        },
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/notifications"
          }
        },
        {
          "name": "UI Settings",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/settings/ui"
          }
        },
        {
          "name": "System General (admin)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/system/general"
          },
          "description": "Branding, site SEO, public theme, reading, discussion, newsletter, permalinks."
        },
        {
          "name": "Meta Error Codes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/meta/error-codes"
          }
        }
      ]
    },
    {
      "name": "Public (no auth)",
      "item": [
        {
          "name": "Site JSON",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/site.json"
          },
          "description": "Machine-readable site document for LLM/AI search. Includes summary, publisher_expertise, preferred_citation, citation_guidance, pillar_topics, and discovery endpoints."
        },
        {
          "name": "Post JSON",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/blog/welcome.json"
          },
          "description": "Replace slug with a published post slug."
        },
        {
          "name": "Sitemap",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/sitemap.xml"
          }
        },
        {
          "name": "RSS Feed",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/feed.xml"
          }
        },
        {
          "name": "Robots",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/robots.txt"
          }
        },
        {
          "name": "llms.txt",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/llms.txt"
          },
          "description": "llmstxt.org index for AI assistants (disable in General → SEO)."
        },
        {
          "name": "llms-full.txt",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/llms-full.txt"
          }
        },
        {
          "name": "Blog JSON catalog",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/blog.json"
          }
        },
        {
          "name": "Share media (full)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/share/media/1"
          },
          "description": "Public original image. Replace 1 with a real media id."
        },
        {
          "name": "Share media (medium size)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/share/media/1/medium"
          },
          "description": "WordPress-style intermediate size. Falls back to full if missing."
        }
      ]
    },
    {
      "name": "Admin editor (session cookie)",
      "item": [
        {
          "name": "Upload media JSON (from page/post form)",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "csrf_token", "value": "{{csrf}}", "type": "text"},
                {"key": "file", "type": "file", "src": []},
                {"key": "alt_text", "value": "Optional alt", "type": "text"}
              ]
            },
            "url": "{{baseUrl}}/admin/media/upload-json"
          },
          "description": "Requires logged-in admin session cookie. Used by featured image and block builder upload buttons."
        },
        {
          "name": "Quick create category",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "csrf_token", "value": "{{csrf}}", "type": "text"},
                {"key": "name", "value": "News", "type": "text"}
              ]
            },
            "url": "{{baseUrl}}/admin/categories/quick-store"
          }
        },
        {
          "name": "Save page visual layout",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "csrf_token", "value": "{{csrf}}", "type": "text"},
                {"key": "layout_json", "value": "{\"version\":1,\"sections\":[]}", "type": "text"}
              ]
            },
            "url": "{{baseUrl}}/admin/builder/page/1/save"
          },
          "description": "Requires session cookie + edit_pages. Empty sections clears layout_json. Replace 1 with a real page id."
        },
        {
          "name": "Save post visual layout",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "csrf_token", "value": "{{csrf}}", "type": "text"},
                {"key": "layout_json", "value": "{\"version\":1,\"sections\":[]}", "type": "text"}
              ]
            },
            "url": "{{baseUrl}}/admin/builder/post/1/save"
          },
          "description": "Requires session cookie + edit_posts. Replace 1 with a real post id."
        },
        {
          "name": "Content library search",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/search?q=tomeng"
          },
          "description": "Session cookie required. Searches pages, posts, and media."
        }
      ]
    }
  ]
}
