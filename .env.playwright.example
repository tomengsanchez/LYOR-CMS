# Playwright E2E — copy to .env.playwright (gitignored) for local runs
BASE_URL=http://cms.local
ADMIN_USER=admin
ADMIN_PASS=admin123

# CMS E2E (headless, fast):
#   npm run test:e2e:cms
# Pulse widgets → password gate (headless):
#   npm run test:e2e:cms-pulse-ux
# Newsletter signup + admin list (headless):
#   npm run test:e2e:cms-newsletter
# Headed with slow motion (watch tests):
#   npm run test:e2e:cms:headed
# Sample pages (distinct layouts) + Primary Menu:
#   npm run test:e2e:cms-pages-layouts-menu
# Team POGI site (5 pages + 5 posts + free images):
#   npm run test:e2e:cms-team-pogi-site
# Visual builder drag + column width/height (headed demo):
#   npm run test:e2e:cms-builder-drag-column-size

# Headless mode (recommended for CI / fast local runs)
# HEADLESS=true
# PW_SLOW_MO_MS=0

# If you manually set HEADLESS in PowerShell it persists for the session — clear it:
#   Remove-Item Env:HEADLESS -ErrorAction SilentlyContinue

# Skip migrate status check in global setup
# E2E_SKIP_MIGRATE=1

# Production deploy verification (fails if ADMIN_PASS is still admin123)
# E2E_PRODUCTION_BLOCKERS=1
